#: src/settings_translation_file.cpp
msgid ""
"Specifies URL from which client fetches media instead of using UDP.\n"
"$filename should be accessible from $remote_media$filename via cURL\n"
"(obviously, remote_media should end with a slash).\n"
"Files that are not present will be fetched the usual way."
msgstr "يحدد عنوان URL الذي يجلب العميل منه الوسائط بدلاً من استخدام UDP.\nيجب أن يكون $filename متاحاً عبر cURL من خلال المسار $remote_media$filename\n(ومن الواضح أن remote_media يجب أن ينتهي بشرطة مائلة).\nأما الملفات غير الموجودة هناك فسيتم جلبها بالطريقة المعتادة."

#: src/settings_translation_file.cpp
msgid ""
"Specifies the default stack size of nodes, items and tools.\n"
"Note that mods or games may explicitly set a stack for certain (or all) "
"items."
msgstr "يحدد حجم الرزمة الافتراضي للعقد والعناصر والأدوات.\nلاحظ أن الإضافات أو الألعاب قد تحدد صراحةً حجم رزمة لبعض العناصر أو كلها."

#: src/settings_translation_file.cpp
msgid ""
"Spread a complete update of the shadow map over a given number of frames.\n"
"Higher values might make shadows laggy, lower values\n"
"will consume more resources."
msgstr "توزيع التحديث الكامل لخريطة الظلال على عدد محدد من الإطارات.\nقد تجعل القيم الأعلى الظلال متأخرة، بينما تستهلك القيم الأقل موارد أكثر."

#: src/settings_translation_file.cpp
msgid ""
"Spread of light curve boost range.\n"
"Controls the width of the range to be boosted.\n"
"Standard deviation of the light curve boost Gaussian."
msgstr "اتساع نطاق تعزيز منحنى الإضاءة.\nيتحكم في عرض النطاق الذي ستتم زيادة سطوعه.\nيمثل الانحراف المعياري لتوزيع غاوسي لتعزيز منحنى الإضاءة."

#: src/settings_translation_file.cpp
msgid "Static spawn point"
msgstr "نقطة ظهور ثابتة"

#: src/settings_translation_file.cpp
msgid "Steepness noise"
msgstr "ضجيج الانحدار"

#: src/settings_translation_file.cpp
msgid "Step mountain size noise"
msgstr "ضجيج حجم الجبال المدرّجة"

#: src/settings_translation_file.cpp
msgid "Step mountain spread noise"
msgstr "ضجيج انتشار الجبال المدرّجة"

#: src/settings_translation_file.cpp
msgid "Strength of 3D mode parallax."
msgstr "قوة اختلاف المنظر في الوضع ثلاثي الأبعاد."

#: src/settings_translation_file.cpp
msgid ""
"Strength of light curve boost.\n"
"The 3 'boost' parameters define a range of the light\n"
"curve that is boosted in brightness."
msgstr "قوة تعزيز منحنى الإضاءة.\nتحدد معاملات 'boost' الثلاثة نطاقاً من منحنى الإضاءة\nتتم زيادة سطوعه."

#: src/settings_translation_file.cpp
msgid "Strict protocol checking"
msgstr "التدقيق الصارم للبروتوكول"

#: src/settings_translation_file.cpp
msgid "Strip color codes"
msgstr "إزالة رموز الألوان"

#: src/settings_translation_file.cpp
msgid ""
"Surface level of optional water placed on a solid floatland layer.\n"
"Water is disabled by default and will only be placed if this value is set\n"
"to above 'mgv7_floatland_ymax' - 'mgv7_floatland_taper' (the start of the\n"
"upper tapering).\n"
"***WARNING, POTENTIAL DANGER TO WORLDS AND SERVER PERFORMANCE***:\n"
"When enabling water placement, floatlands must be configured and tested\n"
"to be a solid layer by setting 'mgv7_floatland_density' to 2.0 (or other\n"
"required value depending on 'mgv7_np_floatland'), to avoid\n"
"server-intensive extreme water flow and to avoid vast flooding of the\n"
"world surface below."
msgstr "مستوى سطح الماء الاختياري الذي يوضع فوق طبقة صلبة من الأراضي العائمة.\nيكون الماء معطلاً افتراضياً، ولا يوضع إلا إذا ضُبطت هذه القيمة على قيمة أعلى\nمن 'mgv7_floatland_ymax' - 'mgv7_floatland_taper' (بداية التضييق العلوي).\n***تحذير: قد يشكل ذلك خطراً على العوالم وأداء الخادم***:\nعند تفعيل وضع الماء، يجب ضبط الأراضي العائمة واختبارها للتأكد من أنها طبقة صلبة،\nوذلك بتعيين 'mgv7_floatland_density' على 2.0 (أو قيمة أخرى مطلوبة وفقاً لـ\n'mgv7_np_floatland')، لتجنب تدفق ماء شديد يرهق الخادم\nويتسبب في غمر مساحات واسعة من سطح العالم الواقع أسفلها."

#: src/settings_translation_file.cpp
msgid "Synchronous SQLite"
msgstr "مزامنة SQLite"

#: src/settings_translation_file.cpp
msgid "Temperature variation for biomes."
msgstr "تغيرات درجة الحرارة في المناطق الأحيائية."

#: src/settings_translation_file.cpp
msgid "Terrain alternative noise"
msgstr "ضجيج التضاريس البديل"

#: src/settings_translation_file.cpp
msgid "Terrain base noise"
msgstr "ضجيج التضاريس الأساسي"

#: src/settings_translation_file.cpp
msgid "Terrain height"
msgstr "ارتفاع التضاريس"

#: src/settings_translation_file.cpp
msgid "Terrain higher noise"
msgstr "ضجيج التضاريس الأعلى"

#: src/settings_translation_file.cpp
msgid "Terrain noise"
msgstr "ضجيج التضاريس"

#: src/settings_translation_file.cpp
msgid ""
"Terrain noise threshold for hills.\n"
"Controls proportion of world area covered by hills.\n"
"Adjust towards 0.0 for a larger proportion."
msgstr "عتبة ضجيج التضاريس للتلال.\nتتحكم في نسبة مساحة العالم التي تغطيها التلال.\nقرّب القيمة من 0.0 لزيادة هذه النسبة."

#: src/settings_translation_file.cpp
msgid ""
"Terrain noise threshold for lakes.\n"
"Controls proportion of world area covered by lakes.\n"
"Adjust towards 0.0 for a larger proportion."
msgstr "عتبة ضجيج التضاريس للبحيرات.\nتتحكم في نسبة مساحة العالم التي تغطيها البحيرات.\nقرّب القيمة من 0.0 لزيادة هذه النسبة."

#: src/settings_translation_file.cpp
msgid "Terrain persistence noise"
msgstr "ضجيج استمرارية التضاريس"

#: src/settings_translation_file.cpp
msgid ""
"Texture size to render the shadow map on.\n"
"This must be a power of two.\n"
"Bigger numbers create better shadows but it is also more expensive."
msgstr "حجم النسيج المستخدم لرسم خريطة الظلال.\nيجب أن تكون القيمة قوة للعدد 2.\nتنتج القيم الأكبر ظلالاً أفضل، لكنها تستهلك موارد أكثر."

#: src/settings_translation_file.cpp
msgid ""
"Textures on a node may be aligned either to the node or to the world.\n"
"The former mode suits better things like machines, furniture, etc., while\n"
"the latter makes stairs and microblocks fit surroundings better.\n"
"However, as this possibility is new, thus may not be used by older servers,\n"
"this option allows enforcing it for certain node types. Note though that\n"
"that is considered EXPERIMENTAL and may not work properly."
msgstr "يمكن محاذاة أنسجة العقدة إما بالنسبة إلى العقدة نفسها أو إلى العالم.\nيناسب الخيار الأول أشياء مثل الآلات والأثاث وما شابه، بينما يجعل الخيار الثاني\nالسلالم والكتل الدقيقة أكثر انسجاماً مع البيئة المحيطة.\nلكن لأن هذه الميزة جديدة وقد لا تدعمها الخوادم القديمة، يتيح هذا الخيار فرضها\nعلى أنواع معينة من العقد. لاحظ أن هذه الميزة تجريبية وقد لا تعمل بصورة صحيحة."

#: src/settings_translation_file.cpp
msgid "The URL for the content repository"
msgstr "عنوان URL لمستودع المحتوى"

#: src/settings_translation_file.cpp
msgid ""
"The default format in which profiles are being saved,\n"
"when calling `/profiler save [format]` without format."
msgstr "التنسيق الافتراضي لحفظ ملفات تحليل الأداء\nعند استدعاء `/profiler save [format]` دون تحديد تنسيق."

#: src/settings_translation_file.cpp
msgid ""
"The delay in milliseconds after which a touch interaction is considered a "
"long tap."
msgstr "المدة بالمللي ثانية التي بعدها يُعد التفاعل باللمس ضغطة مطوّلة."

#: src/settings_translation_file.cpp
msgid ""
"The file path relative to your world path in which profiles will be saved to."
msgstr "مسار الملف النسبي إلى مجلد العالم الذي ستُحفظ فيه ملفات تحليل الأداء."

#: src/settings_translation_file.cpp
msgid ""
"The gesture for punching players/entities.\n"
"This can be overridden by games and mods.\n"
"\n"
"* Short tap\n"
"Easy to use and well-known from other games that shall not be named.\n"
"\n"
"* Long tap\n"
"Known from the classic Luanti mobile controls.\n"
"Combat is more or less impossible."
msgstr "الإيماءة المستخدمة لضرب اللاعبين أو الكيانات.\nيمكن للألعاب والإضافات تجاوز هذا الإعداد.\n\n* ضغطة قصيرة\nسهلة الاستخدام ومعروفة من ألعاب أخرى لا داعي لتسميتها.\n\n* ضغطة مطوّلة\nمعروفة من عناصر التحكم المحمولة الكلاسيكية في Luanti.\nتجعل القتال صعباً للغاية."

#: src/settings_translation_file.cpp
msgid ""
"The kind of digging/placing controls used.\n"
"\n"
"* Tap\n"
"Long/short tap anywhere on the screen to interact.\n"
"Interaction happens at finger position.\n"
"\n"
"* Tap with crosshair\n"
"Long/short tap anywhere on the screen to interact.\n"
"Interaction happens at crosshair position.\n"
"\n"
"* Buttons with crosshair\n"
"Use dedicated dig/place buttons to interact.\n"
"Interaction happens at crosshair position."
msgstr "نوع عناصر التحكم المستخدمة للحفر والوضع.\n\n* النقر\nانقر ضغطة قصيرة أو مطوّلة في أي مكان على الشاشة للتفاعل.\nيحدث التفاعل عند موضع الإصبع.\n\n* النقر مع مؤشر التصويب\nانقر ضغطة قصيرة أو مطوّلة في أي مكان على الشاشة للتفاعل.\nيحدث التفاعل عند موضع مؤشر التصويب.\n\n* أزرار مع مؤشر التصويب\nاستخدم أزراراً مخصصة للحفر والوضع.\nيحدث التفاعل عند موضع مؤشر التصويب."

#: src/settings_translation_file.cpp
msgid ""
"The length in pixels after which a touch interaction is considered movement."
msgstr "المسافة بالبكسل التي بعدها يُعد التفاعل باللمس حركة."

#: src/settings_translation_file.cpp
msgid ""
"The maximum height of the surface of waving liquids.\n"
"4.0 = Wave height is two nodes.\n"
"0.0 = Wave doesn't move at all.\n"
"Default is 1.0 (1/2 node)."
msgstr "أقصى ارتفاع لسطح السوائل المتحركة.\n4.0 = ارتفاع الموجة عقدتان.\n0.0 = لا تتحرك الموجة إطلاقاً.\nالقيمة الافتراضية 1.0 (نصف عقدة)."

#: src/settings_translation_file.cpp
msgid ""
"The minimum time in seconds it takes between digging nodes when holding\n"
"the dig button."
msgstr "أقل مدة بالثواني بين عمليات حفر العقد عند الاستمرار في الضغط على زر الحفر."

#: src/settings_translation_file.cpp
msgid "The network interface that the server listens on."
msgstr "واجهة الشبكة التي يستمع إليها الخادم."

#: src/settings_translation_file.cpp
msgid ""
"The privileges that new users automatically get.\n"
"See /privs in game for a full list on your server and mod configuration."
msgstr "الصلاحيات التي يحصل عليها المستخدمون الجدد تلقائياً.\nاستخدم الأمر /privs داخل اللعبة لعرض القائمة الكاملة وفق إعدادات الخادم والإضافات."

#: src/settings_translation_file.cpp
msgid ""
"The radius of the volume of blocks around every player that is subject to "
"the\n"
"active block stuff, stated in mapblocks (16 nodes).\n"
"In active blocks objects are loaded and ABMs run.\n"
"This is also the minimum range in which active objects (mobs) are "
"maintained.\n"
"This should be configured together with active_object_send_range_blocks."
msgstr "نصف قطر منطقة الكتل المحيطة بكل لاعب التي تطبق عليها عمليات الكتل النشطة،\nبوحدة كتل الخريطة (16 عقدة).\nتُحمّل الكائنات وتُنفّذ معدّلات الكتل النشطة (ABM) داخل هذه المنطقة.\nوهذا أيضاً الحد الأدنى للنطاق الذي تُحفظ ضمنه الكائنات النشطة.\nينبغي ضبط هذا الخيار بالتزامن مع active_object_send_range_blocks."

#: src/settings_translation_file.cpp
msgid ""
"The rendering back-end.\n"
"Note: A restart is required after changing this!\n"
"By default OpenGL3 is preferred on desktop, or OGLES2 on Android."
msgstr "واجهة العرض الخلفية.\nملاحظة: يتطلب تغييرها إعادة تشغيل المحرك.\nيُفضّل OpenGL3 افتراضياً على أجهزة سطح المكتب، وOGLES2 على Android."

#: src/settings_translation_file.cpp
msgid ""
"The sensitivity of the joystick axes for moving the\n"
"in-game view frustum around."
msgstr "حساسية محاور عصا التحكم لتحريك مجال الرؤية داخل اللعبة."

#: src/settings_translation_file.cpp
msgid ""
"The strength (darkness) of node ambient-occlusion shading.\n"
"Lower is darker, Higher is lighter. The valid range of values for this\n"
"setting is 0.25 to 4.0 inclusive. If the value is out of range it will be\n"
"set to the nearest valid value."
msgstr "قوة (درجة قتامة) تظليل الإظلال المحيطي للعقد.\nالقيمة الأقل تعني تظليلاً أغمق، والقيمة الأعلى تعني تظليلاً أفتح.\nالنطاق الصالح لهذا الإعداد من 0.25 إلى 4.0 شاملاً. إذا كانت القيمة خارج النطاق،\nفسيتم ضبطها على أقرب قيمة صالحة."

#: src/settings_translation_file.cpp
msgid ""
"The time (in seconds) that the liquids queue may grow beyond processing\n"
"capacity until an attempt is made to decrease its size by dumping old queue\n"
"items.  A value of 0 disables the functionality."
msgstr "المدة (بالثواني) التي يُسمح خلالها لقائمة انتظار السوائل بتجاوز قدرة المعالجة\nقبل محاولة تقليل حجمها بحذف العناصر القديمة من القائمة.\nتعطّل القيمة 0 هذه الوظيفة."

#: src/settings_translation_file.cpp
msgid ""
"The time budget allowed for ABMs to execute on each step\n"
"(as a fraction of the ABM Interval)"
msgstr "الميزانية الزمنية المسموح بها لتنفيذ معدّلات الكتل النشطة (ABM) في كل خطوة\n(كجزء من الفاصل الزمني لـABM)."

#: src/settings_translation_file.cpp
msgid ""
"The time in seconds it takes between repeated events\n"
"when holding down a joystick button combination."
msgstr "المدة بالثواني بين الأحداث المتكررة عند الاستمرار في الضغط على مجموعة أزرار في عصا التحكم."

#: src/settings_translation_file.cpp
msgid ""
"The time in seconds it takes between repeated node placements when holding\n"
"the place button."
msgstr "المدة بالثواني بين عمليات وضع العقد المتكررة عند الاستمرار في الضغط على زر الوضع."

#: src/settings_translation_file.cpp
msgid ""
"The vertical distance over which heat drops by 20 if 'altitude_chill' is\n"
"enabled. Also, the vertical distance over which humidity drops by 10 if\n"
"'altitude_dry' is enabled."
msgstr "المسافة الرأسية التي تنخفض خلالها الحرارة بمقدار 20 عند تفعيل 'altitude_chill'.\nوهي أيضاً المسافة الرأسية التي تنخفض خلالها الرطوبة بمقدار 10 عند تفعيل\n'altitude_dry'."

#: src/settings_translation_file.cpp
msgid "Third of 4 2D noises that together define hill/mountain range height."
msgstr "ثالث ضجيج من أربعة ضوضاء ثنائية الأبعاد تحدد مجتمعة ارتفاع التلال وسلاسل الجبال."

#: src/settings_translation_file.cpp
msgid "Threshold for long taps"
msgstr "عتبة الضغطة المطوّلة"

#: src/settings_translation_file.cpp
msgid ""
"Time in seconds for item entity (dropped items) to live.\n"
"Setting it to -1 disables the feature."
msgstr "مدة بقاء كيان العنصر (العناصر المسقطة) بالثواني.\nاضبط القيمة على ‎-1 لتعطيل هذه الميزة."

#: src/settings_translation_file.cpp
msgid "Time of day when a new world is started, in millihours (0-23999)."
msgstr "وقت اليوم عند بدء عالم جديد، بوحدة الألف من الساعة (0-23999)."

#: src/settings_translation_file.cpp
msgid "Time speed"
msgstr "سرعة مرور الوقت"

#: src/settings_translation_file.cpp
msgid "Timeout for client to remove unused map data from memory, in seconds."
msgstr "المهلة التي ينتظرها العميل قبل إزالة بيانات الخريطة غير المستخدمة من الذاكرة، بالثواني."

#: src/settings_translation_file.cpp
msgid "Tint sunlight during sunrise/sunset."
msgstr "إضفاء صبغة لونية على ضوء الشمس أثناء الشروق والغروب."

#: src/settings_translation_file.cpp
msgid "Tinted fog"
msgstr "ضباب ملوّن"

#: src/settings_translation_file.cpp
msgid "Tinted sunlight"
msgstr "ضوء شمس ملوّن"

#: src/settings_translation_file.cpp
msgid ""
"To save bandwidth, block transfers are slowed down when a player is building "
"something.\n"
"This determines how long the throttling lasts after placing a node."
msgstr "لتوفير عرض النطاق الترددي، تُبطّأ عمليات نقل الكتل عندما يبني اللاعب شيئاً.\nيحدد هذا الإعداد مدة استمرار التقييد بعد وضع عقدة."

#: src/settings_translation_file.cpp
msgid "Toggle Aux1 key"
msgstr "تبديل مفتاح Aux1"

#: src/settings_translation_file.cpp
msgid "Toggle HUD"
msgstr "بدّل عرض الواجهة"

#: src/settings_translation_file.cpp
msgid "Toggle Sneak key"
msgstr "تبديل مفتاح التسلل (Sneak)"

#: src/settings_translation_file.cpp
msgid "Toggle automatic forward"
msgstr "تبديل التقدم التلقائي"

#: src/settings_translation_file.cpp
msgid "Toggle block bounds"
msgstr "تبديل عرض حدود الكتل"

#: src/settings_translation_file.cpp
msgid "Toggle camera mode"
msgstr "تبديل وضع الكاميرا"

#: src/settings_translation_file.cpp
msgid "Toggle camera update"
msgstr "تبديل تحديث الكاميرا"

#: src/settings_translation_file.cpp
msgid "Toggle cinematic mode"
msgstr "تبديل الوضع السينمائي"

#: src/settings_translation_file.cpp
msgid "Toggle debug info"
msgstr "تبديل معلومات التصحيح"

#: src/settings_translation_file.cpp
msgid "Toggle fog"
msgstr "بدّل ظهور الضباب"

#: src/settings_translation_file.cpp
msgid "Toggle fullscreen"
msgstr "تبديل وضع ملء الشاشة"

#: src/settings_translation_file.cpp
msgid "Toggle large chat console"
msgstr "تبديل حجم وحدة تحكم الدردشة"

#: src/settings_translation_file.cpp
msgid "Toggle pitchmove"
msgstr "تبديل الحركة العمودية وفق زاوية النظر"

#: src/settings_translation_file.cpp
msgid "Toggle profiler"
msgstr "تبديل محلّل الأداء"

#: src/settings_translation_file.cpp
msgid "Toggle unlimited view range"
msgstr "تبديل مدى الرؤية غير المحدود"

#: src/settings_translation_file.cpp
msgid ""
"Tolerance of movement cheat detector.\n"
"Increase the value if players experience stuttery movement."
msgstr "هامش التسامح في كاشف الغش بالحركة.\nزِد القيمة إذا واجه اللاعبون حركة متقطعة."

#: src/settings_translation_file.cpp
msgid "Tooltip delay"
msgstr "تأخير ظهور التلميح"

#: src/settings_translation_file.cpp
msgid "Touchscreen"
msgstr "شاشة اللمس"

#: src/settings_translation_file.cpp
msgid "Touchscreen controls"
msgstr "عناصر التحكم باللمس"

#: src/settings_translation_file.cpp
msgid "Touchscreen sensitivity"
msgstr "حساسية شاشة اللمس"

#: src/settings_translation_file.cpp
msgid "Touchscreen sensitivity multiplier."
msgstr "مضاعف حساسية شاشة اللمس."

#: src/settings_translation_file.cpp
msgid "Tradeoffs for performance"
msgstr "مقايضات تحسين الأداء"

#: src/settings_translation_file.cpp
msgid "Translucent foliage"
msgstr "أوراق نباتات شبه شفافة"

#: src/settings_translation_file.cpp
msgid "Translucent liquids"
msgstr "سوائل شبه شفافة"

#: src/settings_translation_file.cpp
msgid "Transparency Sorting Distance"
msgstr "مسافة ترتيب الشفافية"

#: src/settings_translation_file.cpp
msgid "Transparency Sorting Group by Buffers"
msgstr "تجميع ترتيب الشفافية حسب المخازن"

#: src/settings_translation_file.cpp
msgid "Trees noise"
msgstr "ضجيج الأشجار"

#: src/settings_translation_file.cpp
msgid "Trilinear filtering"
msgstr "الترشيح ثلاثي الخطية"

#: src/settings_translation_file.cpp
msgid ""
"True = 256\n"
"False = 128\n"
"Usable to make minimap smoother on slower machines."
msgstr "True = 256\nFalse = 128\nيمكن استخدام هذا الخيار لجعل الخريطة المصغرة أكثر سلاسة على الأجهزة الأبطأ."

#: src/settings_translation_file.cpp
msgid "Trusted mods"
msgstr "الإضافات الموثوقة"

#: src/settings_translation_file.cpp
msgid ""
"Type of occlusion_culler\n"
"\n"
"\"loops\" is the legacy algorithm with nested loops and O(n³) complexity\n"
"\"bfs\" is the new algorithm based on breadth-first-search and side culling\n"
"\n"
"This setting should only be changed if you have performance problems."
msgstr "نوع خوارزمية occlusion_culler.\n\n\"loops\" هي الخوارزمية القديمة المعتمدة على حلقات متداخلة وتعقيد O(n³).\n\"bfs\" هي الخوارزمية الجديدة المعتمدة على البحث بالعرض أولاً واستبعاد الجوانب.\n\nلا تغيّر هذا الإعداد إلا إذا واجهت مشكلات في الأداء."

#: src/settings_translation_file.cpp
msgid ""
"URL to JSON file which provides information about the newest Luanti "
"release.\n"
"If this is empty the engine will never check for updates."
msgstr "عنوان URL لملف JSON الذي يوفر معلومات عن أحدث إصدار من Luanti.\nإذا كانت القيمة فارغة، فلن يتحقق المحرك من وجود تحديثات مطلقاً."

#: src/settings_translation_file.cpp
msgid "URL to the server list displayed in the Multiplayer Tab."
msgstr "عنوان URL لقائمة الخوادم المعروضة في تبويب اللعب الجماعي."

#: src/settings_translation_file.cpp
msgid "Undersampling"
msgstr "تقليل عينات العرض"

#: src/settings_translation_file.cpp
msgid ""
"Undersampling is similar to using a lower screen resolution, but it applies\n"
"to the game world only, keeping the GUI intact.\n"
"It should give a significant performance boost at the cost of less detailed "
"image.\n"
"Higher values result in a less detailed image.\n"
"Note: Undersampling is currently not supported if the \"3d_mode\" setting is "
"set\n"
"to a non-default value."
msgstr "يشبه تقليل عينات العرض استخدام دقة شاشة أقل، لكنه يطبق على عالم اللعبة فقط\nمع الإبقاء على واجهة المستخدم دون تغيير.\nينبغي أن يمنح ذلك تحسناً ملحوظاً في الأداء مقابل صورة أقل تفصيلاً.\nتؤدي القيم الأعلى إلى صورة أقل تفصيلاً.\nملاحظة: لا يدعم المحرك حالياً تقليل عينات العرض إذا ضُبط \"3d_mode\" على قيمة غير افتراضية."

#: src/settings_translation_file.cpp
msgid "Unlimited player transfer distance"
msgstr "مسافة نقل غير محدودة للاعبين"

#: src/settings_translation_file.cpp
msgid "Unload unused server data"
msgstr "إلغاء تحميل بيانات الخادم غير المستخدمة"

#: src/settings_translation_file.cpp
msgid "Update information URL"
msgstr "عنوان URL لمعلومات التحديث"

#: src/settings_translation_file.cpp
msgid "Upper Y limit of dungeons."
msgstr "الحد الأعلى لإحداثي Y للسراديب."

#: src/settings_translation_file.cpp
msgid "Upper Y limit of floatlands."
msgstr "الحد الأعلى لإحداثي Y للأراضي العائمة."

#: src/settings_translation_file.cpp
msgid "Use a cloud animation for the main menu background."
msgstr "استخدام حركة السحب في خلفية القائمة الرئيسية."

#: src/settings_translation_file.cpp
msgid ""
"Use anisotropic filtering when looking at textures from an angle.\n"
"This provides a significant improvement when used together with mipmapping."
msgstr "استخدام الترشيح متباين الخواص عند النظر إلى الأنسجة من زاوية مائلة.\nيوفر ذلك تحسناً ملحوظاً عند استخدامه مع خرائط Mipmap."

#: src/settings_translation_file.cpp
msgid "Use bilinear filtering when scaling textures."
msgstr "استخدام الترشيح ثنائي الخطية عند تحجيم الأنسجة."

#: src/settings_translation_file.cpp
msgid ""
"Use mipmaps when scaling textures. May slightly increase performance,\n"
"especially when using a high-resolution texture pack.\n"
"Gamma-correct downscaling is not supported."
msgstr "استخدام خرائط Mipmap عند تحجيم الأنسجة. قد يحسن ذلك الأداء قليلاً،\nخصوصاً عند استخدام حزمة أنسجة عالية الدقة.\nلا يدعم المحرك التصغير المصحح وفق غاما."

#: src/settings_translation_file.cpp
msgid ""
"Use raytraced occlusion culling in the new culler.\n"
"This flag enables use of raytraced occlusion culling test for\n"
"client mesh sizes smaller than 4x4x4 map blocks."
msgstr "استخدام استبعاد الكتل المحجوبة بتتبع الأشعة في خوارزمية الاستبعاد الجديدة.\nيفعّل هذا الخيار اختبار الاستبعاد بتتبع الأشعة عندما يكون حجم مجسمات العميل\nأصغر من 4x4x4 كتل خريطة."

#: src/settings_translation_file.cpp
msgid "Use smooth cloud shading."
msgstr "استخدام تظليل ناعم للسحب."

#: src/settings_translation_file.cpp
msgid ""
"Use trilinear filtering when scaling textures.\n"
"If both bilinear and trilinear filtering are enabled, trilinear filtering\n"
"is applied."
msgstr "استخدام الترشيح ثلاثي الخطية عند تحجيم الأنسجة.\nإذا كان الترشيح ثنائي الخطية وثلاثي الخطية مفعّلين معاً، فسيُطبّق الترشيح ثلاثي الخطية."

#: src/settings_translation_file.cpp
msgid ""
"Use virtual joystick to trigger \"Aux1\" button.\n"
"If enabled, virtual joystick will also tap \"Aux1\" button when out of main "
"circle."
msgstr "استخدام عصا التحكم الافتراضية لتفعيل زر \"Aux1\".\nعند التفعيل، ستضغط عصا التحكم الافتراضية أيضاً على زر \"Aux1\" عند تحريكها خارج الدائرة الرئيسية."

#: src/settings_translation_file.cpp
msgid "User Interfaces"
msgstr "واجهات المستخدم"

#: src/settings_translation_file.cpp
msgid "VSync"
msgstr "المزامنة الرأسية (VSync)"

#: src/settings_translation_file.cpp
msgid "Valley depth"
msgstr "عمق الوادي"

#: src/settings_translation_file.cpp
msgid "Valley fill"
msgstr "ملء الوادي"

#: src/settings_translation_file.cpp
msgid "Valley profile"
msgstr "مقطع الوادي"

#: src/settings_translation_file.cpp
msgid "Valley slope"
msgstr "انحدار الوادي"

#: src/settings_translation_file.cpp
msgid "Variation of biome filler depth."
msgstr "تباين عمق مادة ملء المنطقة الأحيائية."

#: src/settings_translation_file.cpp
msgid "Variation of maximum mountain height (in nodes)."
msgstr "تباين أقصى ارتفاع للجبال (بوحدة العقد)."

#: src/settings_translation_file.cpp
msgid "Variation of number of caves."
msgstr "تباين عدد الكهوف."

#: src/settings_translation_file.cpp
msgid ""
"Variation of terrain vertical scale.\n"
"When noise is < -0.55 terrain is near-flat."
msgstr "تباين المقياس الرأسي للتضاريس.\nعندما تكون قيمة الضجيج أقل من ‎-0.55، تصبح التضاريس شبه مسطحة."

#: src/settings_translation_file.cpp
msgid "Varies depth of biome surface nodes."
msgstr "يغيّر عمق عقد سطح المنطقة الأحيائية."

#: src/settings_translation_file.cpp
msgid ""
"Varies roughness of terrain.\n"
"Defines the 'persistence' value for terrain_base and terrain_alt noises."
msgstr "يغيّر خشونة التضاريس.\nويحدد قيمة 'persistence' لضجيجَي terrain_base وterrain_alt."

#: src/settings_translation_file.cpp
msgid "Varies steepness of cliffs."
msgstr "يغيّر انحدار المنحدرات الصخرية."

#: src/settings_translation_file.cpp
msgid "Vertical climbing speed, in nodes per second."
msgstr "سرعة التسلق العمودي، بوحدة العقد في الثانية."

#: src/settings_translation_file.cpp
msgid ""
"Vertical screen synchronization.\n"
"Note: A restart is required after changing this!\n"
"Your system may still force VSync and ignore this setting."
msgstr "المزامنة الرأسية للشاشة.\nملاحظة: يتطلب تغيير هذا الإعداد إعادة تشغيل المحرك.\nقد يفرض نظامك VSync رغم ذلك ويتجاهل هذا الإعداد."

#: src/settings_translation_file.cpp
msgid "Video driver"
msgstr "برنامج تشغيل الفيديو"

#: src/settings_translation_file.cpp
msgid "View bobbing factor"
msgstr "معامل تأرجح الرؤية"

#: src/settings_translation_file.cpp
msgid "View distance in nodes."
msgstr "مسافة الرؤية بوحدة العقد."

#: src/settings_translation_file.cpp
msgid "Viewing range"
msgstr "مدى الرؤية"

#: src/settings_translation_file.cpp
msgid "Virtual joystick triggers Aux1 button"
msgstr "عصا التحكم الافتراضية تفعّل زر Aux1"

#: src/settings_translation_file.cpp
msgid "Volume"
msgstr "مستوى الصوت"

#: src/settings_translation_file.cpp
msgid "Volume multiplier when the window is unfocused."
msgstr "مضاعف مستوى الصوت عند فقدان تركيز النافذة."

#: src/settings_translation_file.cpp
msgid ""
"Volume of all sounds.\n"
"Requires the sound system to be enabled."
msgstr "مستوى صوت جميع الأصوات.\nيتطلب ذلك تفعيل نظام الصوت."

#: src/settings_translation_file.cpp
msgid "Volume when unfocused"
msgstr "مستوى الصوت عند فقدان التركيز"

#: src/settings_translation_file.cpp
msgid "Volumetric Depth Attenuation"
msgstr "توهين العمق الحجمي"

#: src/settings_translation_file.cpp
msgid "Volumetric Lighting"
msgstr "الإضاءة الحجمية"

#: src/settings_translation_file.cpp
msgid ""
"W coordinate of the generated 3D slice of a 4D fractal.\n"
"Determines which 3D slice of the 4D shape is generated.\n"
"Alters the shape of the fractal.\n"
"Has no effect on 3D fractals.\n"
"Range roughly -2 to 2."
msgstr "إحداثي W للمقطع ثلاثي الأبعاد المولّد من فراكتال رباعي الأبعاد.\nيحدد أي مقطع ثلاثي الأبعاد من الشكل رباعي الأبعاد سيتم توليده.\nيغيّر شكل الفراكتال.\nليس له تأثير على الفراكتالات ثلاثية الأبعاد.\nيتراوح المجال تقريباً من ‎-2 إلى 2."

#: src/settings_translation_file.cpp
msgid "Walking and flying speed, in nodes per second."
msgstr "سرعة المشي والطيران، بوحدة العقد في الثانية."

#: src/settings_translation_file.cpp
msgid "Walking speed"
msgstr "سرعة المشي"

#: src/settings_translation_file.cpp
msgid "Walking, flying and climbing speed in fast mode, in nodes per second."
msgstr "سرعة المشي والطيران والتسلق في الوضع السريع، بوحدة العقد في الثانية."

#: src/settings_translation_file.cpp
msgid "Water level"
msgstr "مستوى الماء"

#: src/settings_translation_file.cpp
msgid "Water surface level of the world."
msgstr "مستوى سطح الماء في العالم."

#: src/settings_translation_file.cpp
msgid "Waving Nodes"
msgstr "عقد متحركة"

#: src/settings_translation_file.cpp
msgid "Waving leaves"
msgstr "أوراق متحركة"

#: src/settings_translation_file.cpp
msgid "Waving liquids"
msgstr "سوائل متحركة"

#: src/settings_translation_file.cpp
msgid "Waving liquids wave height"
msgstr "ارتفاع موجات السوائل المتحركة"

#: src/settings_translation_file.cpp
msgid "Waving liquids wave speed"
msgstr "سرعة موجات السوائل المتحركة"

#: src/settings_translation_file.cpp
msgid "Waving liquids wavelength"
msgstr "طول موجة السوائل المتحركة"

#: src/settings_translation_file.cpp
msgid "Waving plants"
msgstr "نباتات متحركة"

#: src/settings_translation_file.cpp
msgid "Weblink color"
msgstr "لون روابط الويب"

#: src/settings_translation_file.cpp
msgid ""
"When enabled, crude liquid reflections are simulated.\n"
"Wave height, length and speed will affect these reflections."
msgstr "عند التفعيل، تُحاكى انعكاسات السوائل بصورة مبسطة.\nيؤثر ارتفاع الموجة وطولها وسرعتها في هذه الانعكاسات."

#: src/settings_translation_file.cpp
msgid ""
"When enabled, the GUI is optimized to be more usable on touchscreens.\n"
"Whether this is enabled by default depends on your hardware form-factor."
msgstr "عند التفعيل، تُحسّن واجهة المستخدم لتكون أسهل استخداماً على شاشات اللمس.\nيعتمد تفعيل هذا الخيار افتراضياً على شكل جهازك وعتاده."

#: src/settings_translation_file.cpp
msgid ""
"When gui_scaling_filter is true, all GUI images need to be\n"
"filtered in software, but some images are generated directly\n"
"to hardware (e.g. render-to-texture for nodes in inventory)."
msgstr "عند ضبط gui_scaling_filter على true، يجب ترشيح جميع صور واجهة المستخدم\nبرمجياً، لكن بعض الصور تُنشأ مباشرةً على العتاد\n(مثل الرسم إلى نسيج للعقد داخل المخزون)."

#: src/settings_translation_file.cpp
msgid ""
"When using bilinear/trilinear filtering, low-resolution textures\n"
"can be blurred, so this option automatically upscales them to preserve\n"
"crisp pixels. This defines the minimum texture size for the upscaled "
"textures;\n"
"higher values look sharper, but require more memory.\n"
"This setting is ONLY applied if any of the mentioned filters are enabled.\n"
"This is also used as the base node texture size for world-aligned\n"
"texture autoscaling."
msgstr "عند استخدام الترشيح ثنائي أو ثلاثي الخطية، قد تصبح الأنسجة منخفضة الدقة ضبابية.\nلذلك يرفع هذا الخيار دقتها تلقائياً للحفاظ على حواف البكسلات الواضحة.\nتحدد هذه القيمة الحد الأدنى لحجم الأنسجة بعد رفع دقتها؛\nتبدو القيم الأعلى أكثر حدة، لكنها تحتاج إلى ذاكرة أكبر.\nلا يُطبّق هذا الإعداد إلا عند تفعيل أحد المرشحات المذكورة.\nويُستخدم أيضاً كحجم أساسي لنسيج العقد عند التحجيم التلقائي للأنسجة المحاذية للعالم."

#: src/settings_translation_file.cpp
msgid ""
"Where to enable server-sent client-side modding (SSCSM).\n"
"Warning: Experimental."
msgstr "تحديد موضع تفعيل تعديل العميل المرسل من الخادم (SSCSM).\nتحذير: هذه الميزة تجريبية."

#: src/settings_translation_file.cpp
msgid ""
"Whether name tag backgrounds should be shown by default.\n"
"Mods may still set a background."
msgstr "تحديد ما إذا كان ينبغي إظهار خلفيات علامات الأسماء افتراضياً.\nقد تضع الإضافات خلفية رغم ذلك."

#: src/settings_translation_file.cpp
msgid ""
"Whether players are shown to clients without any range limit.\n"
"Deprecated, use the setting player_transfer_distance instead."
msgstr "تحديد ما إذا كان اللاعبون يظهرون للعملاء دون أي حد للمسافة.\nهذا الإعداد مهجور؛ استخدم player_transfer_distance بدلاً منه."

#: src/settings_translation_file.cpp
msgid "Whether the window is maximized."
msgstr "تحديد ما إذا كانت النافذة مكبّرة."

#: src/settings_translation_file.cpp
msgid ""
"Whether to ask clients to reconnect after a (Lua) crash.\n"
"Set this to true if your server is set up to restart automatically."
msgstr "تحديد ما إذا كان ينبغي مطالبة العملاء بإعادة الاتصال بعد تعطل (Lua).\nاضبط القيمة على true إذا كان خادمك مهيأً لإعادة التشغيل تلقائياً."

#: src/settings_translation_file.cpp
msgid "Whether to fog out the end of the visible area."
msgstr "تحديد ما إذا كان ينبغي تغطية نهاية منطقة الرؤية بالضباب."

#: src/settings_translation_file.cpp
msgid ""
"Whether to mute sounds. You can unmute sounds at any time.\n"
"In-game, you can toggle the mute state with the mute key or by using the\n"
"pause menu."
msgstr "تحديد ما إذا كان ينبغي كتم الأصوات. يمكنك إلغاء الكتم في أي وقت.\nداخل اللعبة، يمكنك تبديل حالة الكتم باستخدام مفتاح الكتم أو من قائمة الإيقاف المؤقت."

#: src/settings_translation_file.cpp
msgid ""
"Whether to show the client debug info (has the same effect as hitting F5)."
msgstr "تحديد ما إذا كان ينبغي إظهار معلومات تصحيح العميل (له التأثير نفسه عند الضغط على F5)."

#: src/settings_translation_file.cpp
msgid "Width component of the initial window size."
msgstr "مكوّن العرض من حجم النافذة الأولي."

#: src/settings_translation_file.cpp
msgid "Width of the selection box lines around nodes."
msgstr "عرض خطوط مربع التحديد حول العقد."

#: src/settings_translation_file.cpp
msgid "Will also disable autoforward, when active."
msgstr "سيعطّل أيضاً التقدم التلقائي عند تفعيله."

#: src/settings_translation_file.cpp
msgid "Window maximized"
msgstr "النافذة مكبّرة"

#: src/settings_translation_file.cpp
msgid ""
"Windows systems only: Start Luanti with the command line window in the "
"background.\n"
"Contains the same information as the file debug.txt (default name)."
msgstr "أنظمة Windows فقط: تشغيل Luanti مع إبقاء نافذة سطر الأوامر في الخلفية.\nتحتوي على المعلومات نفسها الموجودة في ملف debug.txt (الاسم الافتراضي)."

#: src/settings_translation_file.cpp
msgid ""
"World directory (everything in the world is stored here).\n"
"Not needed if starting from the main menu."
msgstr "مجلد العالم (تُخزّن فيه جميع بيانات العالم).\nلا يلزم تعيينه عند بدء التشغيل من القائمة الرئيسية."

#: src/settings_translation_file.cpp
msgid "World start time"
msgstr "وقت بدء العالم"

#: src/settings_translation_file.cpp
msgid ""
"World-aligned textures may be scaled to span several nodes. However,\n"
"the server may not send the scale you want, especially if you use\n"
"a specially-designed texture pack; with this option, the client tries\n"
"to determine the scale automatically based on the texture size.\n"
"See also texture_min_size.\n"
"Warning: This option is EXPERIMENTAL!"
msgstr "يمكن تحجيم الأنسجة المحاذية للعالم لتغطي عدة عقد. لكن قد لا يرسل الخادم\nمقياس التحجيم المطلوب، خصوصاً عند استخدام حزمة أنسجة مصممة خصيصاً.\nباستخدام هذا الخيار، يحاول العميل تحديد المقياس تلقائياً استناداً إلى حجم النسيج.\nراجع أيضاً texture_min_size.\nتحذير: هذا الخيار تجريبي!"

#: src/settings_translation_file.cpp
msgid "World-aligned textures mode"
msgstr "وضع الأنسجة المحاذية للعالم"

#: src/settings_translation_file.cpp
msgid "Y of flat ground."
msgstr "إحداثي Y للأرض المسطحة."

#: src/settings_translation_file.cpp
msgid ""
"Y of mountain density gradient zero level. Used to shift mountains "
"vertically."
msgstr "إحداثي Y لمستوى الصفر لتدرج كثافة الجبال. يُستخدم لإزاحة الجبال رأسياً."

#: src/settings_translation_file.cpp
msgid "Y of upper limit of large caves."
msgstr "إحداثي Y للحد العلوي للكهوف الكبيرة."

#: src/settings_translation_file.cpp
msgid "Y-distance over which caverns expand to full size."
msgstr "المسافة الرأسية التي تتسع خلالها الكهوف الكبيرة حتى تصل إلى حجمها الكامل."

#: src/settings_translation_file.cpp
msgid ""
"Y-distance over which floatlands taper from full density to nothing.\n"
"Tapering starts at this distance from the Y limit.\n"
"For a solid floatland layer, this controls the height of hills/mountains.\n"
"Must be less than or equal to half the distance between the Y limits."
msgstr "المسافة الرأسية التي تتناقص خلالها كثافة الأراضي العائمة من الكثافة الكاملة إلى الصفر.\nيبدأ التضييق عند هذه المسافة من حد إحداثي Y.\nفي طبقة أراضٍ عائمة صلبة، يتحكم ذلك في ارتفاع التلال والجبال.\nيجب ألا تتجاوز القيمة نصف المسافة بين حدي Y."

#: src/settings_translation_file.cpp
msgid "Y-level of average terrain surface."
msgstr "مستوى Y لمتوسط سطح التضاريس."

#: src/settings_translation_file.cpp
msgid "Y-level of cavern upper limit."
msgstr "مستوى Y للحد العلوي للكهوف الكبيرة."

#: src/settings_translation_file.cpp
msgid "Y-level of higher terrain that creates cliffs."
msgstr "مستوى Y للتضاريس المرتفعة التي تكوّن المنحدرات الصخرية."

#: src/settings_translation_file.cpp
msgid "Y-level of lower terrain and seabed."
msgstr "مستوى Y للتضاريس المنخفضة وقاع البحر."

#: src/settings_translation_file.cpp
msgid "Y-level of seabed."
msgstr "مستوى Y لقاع البحر."

#: src/settings_translation_file.cpp
msgid "cURL"
msgstr "cURL"

#: src/settings_translation_file.cpp
msgid "cURL file download timeout"
msgstr "مهلة تنزيل الملفات عبر cURL"

#: src/settings_translation_file.cpp
msgid "cURL interactive timeout"
msgstr "مهلة الطلبات التفاعلية عبر cURL"

#: src/settings_translation_file.cpp
msgid "cURL parallel limit"
msgstr "الحد الأقصى لطلبات cURL المتوازية"

#: src/settings_translation_file.cpp
msgid "cURL proxy address"
msgstr "عنوان الخادم الوكيل لـcURL"

#: src/util/screenshot.cpp
#, c-format
msgid "Failed to save screenshot to \"%s\""
msgstr "فشل حفظ لقطة الشاشة في \"%s\""

