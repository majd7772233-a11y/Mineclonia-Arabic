#: src/settings_translation_file.cpp
msgid ""
"Set proxy to use by cURL. This is an URI just like the *_proxy environment "
"variables.\n"
"Note that this will not apply to Luanti's in-game protocol."
msgstr "تعيين الخادم الوكيل الذي يستخدمه cURL. هذه قيمة URI مثل متغيرات البيئة *_proxy.\nلاحظ أن هذا الإعداد لا ينطبق على بروتوكول Luanti داخل اللعبة."

#: src/settings_translation_file.cpp
msgid ""
"Set the default tilt of Sun/Moon orbit in degrees.\n"
"Games may change orbit tilt via API.\n"
"Value of 0 means no tilt / vertical orbit."
msgstr "تعيين الميل الافتراضي لمدار الشمس والقمر بالدرجات.\nيمكن للألعاب تغيير ميل المدار عبر API.\nالقيمة 0 تعني عدم وجود ميل، أي مداراً رأسياً."

#: src/settings_translation_file.cpp
msgid ""
"Set the exposure compensation in EV units.\n"
"Value of 0.0 (default) means no exposure compensation."
msgstr "تعيين تعويض التعريض بوحدات EV.\nالقيمة 0.0 (افتراضية) تعني عدم تطبيق أي تعويض للتعريض."

#: src/settings_translation_file.cpp
msgid ""
"Set the language. By default, the system language is used.\n"
"A restart is required after changing this."
msgstr "تعيين اللغة. تُستخدم لغة النظام افتراضياً.\nيتطلب تغيير هذا الإعداد إعادة تشغيل المحرك."

#: src/settings_translation_file.cpp
msgid ""
"Set the maximum length of a chat message (in characters) sent by clients."
msgstr "تعيين الحد الأقصى لطول رسالة الدردشة (بعدد المحارف) التي يرسلها العملاء."

#: src/settings_translation_file.cpp
msgid ""
"Set the post processing gamma value.\n"
"Higher values give lower contrast and vice versa."
msgstr "تعيين قيمة غاما للمعالجة اللاحقة.\nتؤدي القيم الأعلى إلى تباين أقل، والعكس صحيح."

#: src/settings_translation_file.cpp
msgid ""
"Set the shadow strength gamma.\n"
"Adjusts the intensity of in-game dynamic shadows.\n"
"Lower value means lighter shadows, higher value means darker shadows."
msgstr "تعيين غاما لقوة الظلال.\nيضبط شدة الظلال الديناميكية داخل اللعبة.\nالقيمة الأقل تعني ظلالاً أفتح، والقيمة الأعلى تعني ظلالاً أغمق."

#: src/settings_translation_file.cpp
msgid ""
"Set the soft shadow radius size.\n"
"Lower values mean sharper shadows, bigger values mean softer shadows.\n"
"Minimum value: 1.0; maximum value: 15.0"
msgstr "تعيين نصف قطر الظلال الناعمة.\nالقيم الأقل تعني ظلالاً أكثر حدة، والقيم الأكبر تعني ظلالاً أكثر نعومة.\nالحد الأدنى: 1.0؛ الحد الأقصى: 15.0."

#: src/settings_translation_file.cpp
msgid "Set to true to enable Shadow Mapping."
msgstr "اضبط القيمة على true لتفعيل تقنية رسم خرائط الظلال (Shadow Mapping)."

#: src/settings_translation_file.cpp
msgid ""
"Set to true to enable bloom effect.\n"
"Bright colors will bleed over the neighboring objects."
msgstr "اضبط القيمة على true لتفعيل تأثير التوهج (Bloom).\nستمتد الألوان الساطعة بصرياً إلى الأجسام المجاورة."

#: src/settings_translation_file.cpp
msgid "Set to true to enable volumetric lighting effect (a.k.a. \"Godrays\")."
msgstr "اضبط القيمة على true لتفعيل تأثير الإضاءة الحجمية (المعروف باسم \"Godrays\")."

#: src/settings_translation_file.cpp
msgid "Set to true to enable waving leaves."
msgstr "اضبط القيمة على true لتفعيل حركة أوراق الأشجار."

#: src/settings_translation_file.cpp
msgid "Set to true to enable waving liquids (like water)."
msgstr "اضبط القيمة على true لتفعيل حركة السوائل (مثل الماء)."

#: src/settings_translation_file.cpp
msgid "Set to true to enable waving plants."
msgstr "اضبط القيمة على true لتفعيل حركة النباتات."

#: src/settings_translation_file.cpp
msgid ""
"Set to true to render debugging breakdown of the bloom effect.\n"
"In debug mode, the screen is split into 4 quadrants:\n"
"top-left - processed base image, top-right - final image\n"
"bottom-left - raw base image, bottom-right - bloom texture."
msgstr "اضبط القيمة على true لعرض تحليل تصحيحي لمراحل تأثير التوهج.\nفي وضع التصحيح، تُقسّم الشاشة إلى أربعة أرباع:\nأعلى اليسار - الصورة الأساسية بعد المعالجة، أعلى اليمين - الصورة النهائية.\nأسفل اليسار - الصورة الأساسية الخام، أسفل اليمين - نسيج التوهج."

#: src/settings_translation_file.cpp
msgid ""
"Sets shadow texture quality to 32 bits.\n"
"On false, 16 bits texture will be used.\n"
"This can cause much more artifacts in the shadow."
msgstr "يضبط جودة نسيج الظلال على 32 بت.\nعند ضبط القيمة على false، يُستخدم نسيج بدقة 16 بت.\nقد يؤدي ذلك إلى ظهور تشوهات أكثر في الظلال."

#: src/settings_translation_file.cpp
msgid "Shader path"
msgstr "مسار المظلّل (Shader)"

#: src/settings_translation_file.cpp
msgid "Shadow filter quality"
msgstr "جودة ترشيح الظلال"

#: src/settings_translation_file.cpp
msgid "Shadow map render distance"
msgstr "مسافة عرض خريطة الظلال"

#: src/settings_translation_file.cpp
msgid "Shadow map texture in 32 bits"
msgstr "نسيج خريطة الظلال بدقة 32 بت"

#: src/settings_translation_file.cpp
msgid "Shadow map texture size"
msgstr "حجم نسيج خريطة الظلال"

#: src/settings_translation_file.cpp
