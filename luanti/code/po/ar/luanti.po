msgstr "قيمة Z لمجموعة Julia"

#: src/settings_translation_file.cpp
msgid "Jumping speed"
msgstr "سرعة القفز"

#: src/settings_translation_file.cpp
msgid "Key for decrementing the selected value in Quicktune."
msgstr "المفتاح المستخدم لتقليل القيمة المحددة في Quicktune."

#: src/settings_translation_file.cpp
msgid ""
"Key for digging, punching or using something.\n"
"(Note: The actual meaning might vary on a per-game basis.)"
msgstr "المفتاح المستخدم للحفر أو الضرب أو استخدام شيء ما.\n(ملاحظة: قد يختلف المعنى الفعلي باختلاف اللعبة)."

#: src/settings_translation_file.cpp
msgid "Key for incrementing the selected value in Quicktune."
msgstr "المفتاح المستخدم لزيادة القيمة المحددة في Quicktune."

#: src/settings_translation_file.cpp
msgid "Key for moving fast in fast mode."
msgstr "المفتاح المستخدم للتحرك بسرعة في الوضع السريع."

#: src/settings_translation_file.cpp
msgid "Key for opening the chat window to type commands."
msgstr "المفتاح المستخدم لفتح نافذة الدردشة لكتابة الأوامر."

#: src/settings_translation_file.cpp
msgid "Key for opening the chat window to type local commands."
msgstr "المفتاح المستخدم لفتح نافذة الدردشة لكتابة الأوامر المحلية."

#: src/settings_translation_file.cpp
msgid ""
"Key for opening the pause menu in-game.\n"
"Pressing the escape key always opens the pause menu."
msgstr "المفتاح المستخدم لفتح قائمة الإيقاف المؤقت داخل اللعبة.\nيؤدي الضغط على مفتاح Escape دائماً إلى فتح قائمة الإيقاف المؤقت."

#: src/settings_translation_file.cpp
msgid ""
"Key for placing an item/block or for using something.\n"
"(Note: The actual meaning might vary on a per-game basis.)"
msgstr "المفتاح المستخدم لوضع عنصر أو كتلة أو لاستخدام شيء ما.\n(ملاحظة: قد يختلف المعنى الفعلي باختلاف اللعبة)."

#: src/settings_translation_file.cpp
msgid "Key for switching to the next entry in Quicktune."
msgstr "المفتاح المستخدم للانتقال إلى العنصر التالي في Quicktune."

#: src/settings_translation_file.cpp
msgid "Key for switching to the previous entry in Quicktune."
msgstr "المفتاح المستخدم للانتقال إلى العنصر السابق في Quicktune."

#: src/settings_translation_file.cpp
msgid "Key for toggling the camera update. Only usable with 'debug' privilege."
msgstr "المفتاح المستخدم لتبديل تحديث الكاميرا. لا يمكن استخدامه إلا مع صلاحية 'debug'."

#: src/settings_translation_file.cpp
msgid "Key for toggling the display of mapblock boundaries."
msgstr "المفتاح المستخدم لتبديل عرض حدود كتل الخريطة."

#: src/settings_translation_file.cpp
msgid "Key for toggling the display of the profiler. Used for development."
msgstr "المفتاح المستخدم لتبديل عرض محلّل الأداء. يُستخدم لأغراض التطوير."

#: src/settings_translation_file.cpp
msgid "Keyboard and Mouse"
msgstr "لوحة المفاتيح والفأرة"

#: src/settings_translation_file.cpp
