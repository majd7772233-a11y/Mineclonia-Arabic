msgstr "مسار الخط المائل"

#: src/settings_translation_file.cpp
msgid "Italic monospace font path"
msgstr "مسار الخط ثابت العرض المائل"

#: src/settings_translation_file.cpp
msgid "Item entity TTL"
msgstr "مدة بقاء كيان العنصر (TTL)"

#: src/settings_translation_file.cpp
msgid "Iterations"
msgstr "عدد التكرارات"

#: src/settings_translation_file.cpp
msgid ""
"Iterations of the recursive function.\n"
"Increasing this increases the amount of fine detail, but also\n"
"increases processing load.\n"
"At iterations = 20 this mapgen has a similar load to mapgen V7."
msgstr "عدد مرات تكرار الدالة العودية.\nتؤدي زيادته إلى إظهار تفاصيل أدق، لكنها تزيد أيضاً حمل المعالجة.\nعند iterations = 20 يكون حمل مولّد الخريطة مشابهاً لحمل mapgen V7."

#: src/settings_translation_file.cpp
msgid "Joystick button repetition interval"
msgstr "الفاصل الزمني لتكرار ضغط زر عصا التحكم"

#: src/settings_translation_file.cpp
msgid "Joystick frustum sensitivity"
msgstr "حساسية مجال الرؤية لعصا التحكم"

#: src/settings_translation_file.cpp
msgid "Joystick inner dead zone"
msgstr "منطقة الخمول الداخلية لعصا التحكم"

#: src/settings_translation_file.cpp
msgid "Joystick outer dead zone"
msgstr "منطقة الخمول الخارجية لعصا التحكم"

#: src/settings_translation_file.cpp
msgid ""
"Julia set only.\n"
"W component of hypercomplex constant.\n"
"Alters the shape of the fractal.\n"
"Has no effect on 3D fractals.\n"
"Range roughly -2 to 2."
msgstr "خاص بمجموعات Julia فقط.\nمكوّن W من الثابت فائق التعقيد.\nيغيّر شكل الفراكتال.\nليس له تأثير على الفراكتالات ثلاثية الأبعاد.\nيتراوح المجال تقريباً من ‎-2 إلى 2."

#: src/settings_translation_file.cpp
msgid ""
"Julia set only.\n"
"X component of hypercomplex constant.\n"
"Alters the shape of the fractal.\n"
"Range roughly -2 to 2."
msgstr "خاص بمجموعات Julia فقط.\nمكوّن X من الثابت فائق التعقيد.\nيغيّر شكل الفراكتال.\nيتراوح المجال تقريباً من ‎-2 إلى 2."

#: src/settings_translation_file.cpp
msgid ""
"Julia set only.\n"
"Y component of hypercomplex constant.\n"
"Alters the shape of the fractal.\n"
"Range roughly -2 to 2."
msgstr "خاص بمجموعات Julia فقط.\nمكوّن Y من الثابت فائق التعقيد.\nيغيّر شكل الفراكتال.\nيتراوح المجال تقريباً من ‎-2 إلى 2."

#: src/settings_translation_file.cpp
msgid ""
"Julia set only.\n"
"Z component of hypercomplex constant.\n"
