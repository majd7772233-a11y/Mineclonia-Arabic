#: mods/CORE/mcl_init/init.lua:515
msgid "[<difficulty>]"
msgstr "[<مستوى_الصعوبة>]"

#: mods/CORE/mcl_init/init.lua:516
msgid "Set or query the gameplay difficulty"
msgstr "تعيين مستوى صعوبة اللعب أو الاستعلام عنه"

#: mods/CORE/mcl_init/init.lua:521
msgid "Difficulty: @1"
msgstr "مستوى الصعوبة: @1"

#: mods/CORE/mcl_init/init.lua:525
msgid "This command requires server privileges to run."
msgstr "يتطلب تنفيذ هذا الأمر امتلاك صلاحيات على الخادم."

#: mods/CORE/mcl_init/init.lua:529
msgid ""
"Failed to set difficulty @1.\n"
"Valid values: @2"
msgstr ""
"تعذّر تعيين مستوى الصعوبة إلى @1.\n"
"القيم المقبولة: @2"

#: mods/CORE/mcl_init/init.lua:532
msgid "Difficulty set to @1."
msgstr "تم تعيين مستوى الصعوبة إلى @1."

#: mods/CORE/mcl_init/outdated_warning.lua:6
msgid "Outdated Client version detected!"
msgstr "تم اكتشاف إصدار قديم من العميل!"

#: mods/CORE/mcl_init/outdated_warning.lua:7
msgid "Do not show again"
msgstr "عدم الإظهار مجدداً"

#: mods/CORE/mcl_init/outdated_warning.lua:8
msgid "Leave Server"
msgstr "مغادرة الخادم"

#: mods/CORE/mcl_init/outdated_warning.lua:9
msgid "Ignore"
msgstr "تجاهل"

#: mods/CORE/mcl_init/outdated_warning.lua:10
msgid ""
"You are connecting with an unsupported client. This will generally not keep "
"you from playing the game but you should expect some visual issues, "
"particularly with mobs and certain items.\n"
"\n"
"To enjoy the best mineclonia experience use a minetest/luanti client of "
"version 5.9.0 or greater."
msgstr ""
"أنت تتصل باستخدام إصدار غير مدعوم من العميل. لن يمنعك ذلك عادةً من اللعب، "
"لكن قد تواجه بعض المشكلات المرئية، خصوصاً مع الكائنات وبعض العناصر.\n"
"\n"
"للحصول على أفضل تجربة في Mineclonia، استخدم عميلاً من Luanti بإصدار "
"5.9.0 أو أحدث."
