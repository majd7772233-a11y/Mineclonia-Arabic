msgid "@1 has made the advancement @2"
msgstr "حقق @1 الإنجاز @2"

msgid "Hidden Advancement Unlocked: @1"
msgstr "تم فتح إنجاز مخفي: @1"

msgid "Advancement Unlocked: @1"
