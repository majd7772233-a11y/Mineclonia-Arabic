msgid "All your advancements and statistics have been cleared. You can now start again."
msgstr "تم مسح جميع إنجازاتك وإحصاءاتك. يمكنك الآن البدء من جديد."

msgid "You have disabled advancements."
msgstr "لقد عطّلت الإنجازات."

msgid "You have enabled advancements."
msgstr "لقد فعّلت الإنجازات."

msgid "<advancement ID>"
msgstr "<معرّف الإنجاز>"

msgid "Show details of an advancement"
