msgid "This is the help."
msgstr "هذا هو نظام المساعدة."

msgid "All help entries revealed!"
msgstr "تم إظهار جميع مدخلات المساعدة!"

msgid "All help entries are already revealed."
msgstr "جميع مدخلات المساعدة ظاهرة بالفعل."

msgid "Category list"
msgstr "قائمة الفئات"

msgid "Entry list"
msgstr "قائمة المدخلات"

msgid "Entry"
msgstr "مدخل"

msgid "Error: No help available."
msgstr "خطأ: لا تتوفر مساعدة."

msgid "No categories have been registered, but they are required to provide help."
msgstr "لم تُسجّل أي فئات، مع أن وجودها مطلوب لتوفير المساعدة."

msgid "The Documentation System [doc] does not come with help contents on its own, it needs additional mods to add help content. Please make sure such mods are enabled on for this world, and try again."
msgstr "لا يتضمن نظام التوثيق [doc] محتوى للمساعدة بحد ذاته؛ بل يحتاج إلى وحدات إضافية لإضافة محتوى المساعدة. تأكد من تفعيل هذه الوحدات لهذا العالم، ثم حاول مجدداً."

msgid "Recommended mods: doc_basics, doc_items, doc_identifier, doc_encyclopedia."
msgstr "الوحدات الموصى بها: `doc_basics` و`doc_items` و`doc_identifier` و`doc_encyclopedia`."

msgid "Error: Access denied."
msgstr "خطأ: تم رفض الوصول."

msgid "Access to the requested entry has been denied; this entry is secret. You may unlock access by progressing in the game. Figure out on your own how to unlock this entry."
msgstr "تم رفض الوصول إلى المدخل المطلوب؛ فهذا المدخل سري. يمكنك فتحه بالتقدم في اللعبة. اكتشف بنفسك كيفية فتح هذا المدخل."

msgid "Nameless entry (@1)"
msgstr "مدخل بلا اسم (@1)"

msgid "Help > @1"
msgstr "المساعدة > @1"

msgid "Currently all entries in this category are hidden from you."
msgstr "جميع المدخلات في هذه الفئة مخفية عنك حالياً."

msgid "Unlock new entries by progressing in the game."
msgstr "افتح مدخلات جديدة بالتقدم في اللعبة."

msgid "Number of entries: @1"
msgstr "عدد المدخلات: @1"

msgid "New entries: @1"
msgstr "المدخلات الجديدة: @1"

msgid "Hidden entries: @1"
msgstr "المدخلات المخفية: @1"

msgid "Help > @1 > (No Entry)"
msgstr "المساعدة > @1 > (لا يوجد مدخل)"

msgid "Help > @1 > @2"
msgstr "المساعدة > @1 > @2"

msgid "Open a window providing help entries about Minetest and more"
msgstr "يفتح نافذة تعرض مدخلات المساعدة حول Minetest وغيرها."

msgid "Allows you to reveal all hidden help entries with /help_reveal"
msgstr "يتيح لك إظهار جميع مدخلات المساعدة المخفية باستخدام الأمر `/help_reveal`."

msgid "Reveal all hidden help entries to you"
msgstr "أظهر لك جميع مدخلات المساعدة المخفية."
