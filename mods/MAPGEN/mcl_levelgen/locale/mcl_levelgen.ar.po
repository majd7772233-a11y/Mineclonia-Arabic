#: mods/MAPGEN/mcl_levelgen/jigsaw.lua:157
msgid "Structure Void"
msgstr "فراغ البنية"

#: mods/MAPGEN/mcl_levelgen/jigsaw.lua:158
msgid "Enables structures not to replace existing level contents"
msgstr "يمنع البنى من استبدال محتويات العالم الموجودة."

#: mods/MAPGEN/mcl_levelgen/jigsaw.lua:159
msgid ""
"The presence of a structure void block in a structure template indicates to "
"the level generator that the contents of the level at the position it "
"occupies mustn't be replaced while the template is being generated.\n"
"\n"
"Structure Void nodes are normally invisible unless a Structure Void item is "
"wielded, in which event any Structure Void blocks near the wielder will be "
"revealed by particles containing its item image."
msgstr "وجود كتلة فراغ البنية في قالب بنية يعني لمولّد العالم أن محتويات العالم في الموضع الذي تشغله هذه الكتلة يجب ألا تُستبدل أثناء إنشاء القالب.\n\nتكون عقد فراغ البنية غير مرئية عادةً، إلا عند حمل عنصر فراغ البنية باليد؛ عندها ستظهر كتل فراغ البنية القريبة من اللاعب بواسطة جسيمات تعرض صورة العنصر."

#: mods/MAPGEN/mcl_levelgen/jigsaw.lua:254
