#: mods/MAPGEN/mcl_biome_dispatch/init.lua:791
msgid "Loading terrain"
msgstr "جارٍ تحميل التضاريس"

#: mods/MAPGEN/mcl_biome_dispatch/init.lua:1103
msgid ""
"Locate a structure, biome, or point of interest identified by ID in the "
"current dimension."
msgstr "حدّد موقع بنية أو منطقة أحيائية أو نقطة اهتمام باستخدام المعرّف الخاص بها في البُعد الحالي."

#: mods/MAPGEN/mcl_biome_dispatch/init.lua:1109
msgid ""
"/locate structure requires a structure ID.\n"
"These structures are available: "
msgstr "يتطلب الأمر `/locate structure` معرّف بنية.\nالبنى المتاحة هي: "

#: mods/MAPGEN/mcl_biome_dispatch/init.lua:1121
msgid ""
"The nearest structure of type @1 is located at (@2,@3,@4) (@5 block away)"
msgid_plural ""
"The nearest structure of type @1 is located at (@2,@3,@4) (@5 blocks away)"
msgstr[0] "أقرب بنية من النوع @1 تقع عند الإحداثيات (@2، @3، @4) (على بُعد @5 كتلة)."
msgstr[1] "أقرب بنية من النوع @1 تقع عند الإحداثيات (@2، @3، @4) (على بُعد @5 كتلة)."
msgstr[2] "أقرب بنية من النوع @1 تقع عند الإحداثيات (@2، @3، @4) (على بُعد @5 كتلة)."
msgstr[3] "أقرب بنية من النوع @1 تقع عند الإحداثيات (@2، @3، @4) (على بُعد @5 كتل)."
msgstr[4] "أقرب بنية من النوع @1 تقع عند الإحداثيات (@2، @3، @4) (على بُعد @5 كتلة)."
msgstr[5] "أقرب بنية من النوع @1 تقع عند الإحداثيات (@2، @3، @4) (على بُعد @5 كتلة)."

#: mods/MAPGEN/mcl_biome_dispatch/init.lua:1126
msgid "No structure of type @1 exists near your position"
msgstr "لا توجد بنية من النوع @1 بالقرب من موقعك."

#: mods/MAPGEN/mcl_biome_dispatch/init.lua:1135
msgid ""
"/locate biome requires a biome ID or a tag prefixed with `#'.\n"
"These biomes and tags are available: "
msgstr "يتطلب الأمر `/locate biome` معرّف منطقة أحيائية أو وسماً مسبوقاً بالرمز `#`.\nالمناطق الأحيائية والوسوم المتاحة هي: "

#: mods/MAPGEN/mcl_biome_dispatch/init.lua:1147
msgid "The nearest biome matching @1 is located at (@2,@3,@4) (@5 block away)"
msgid_plural ""
"The nearest biome matching @1 is located at (@2,@3,@4) (@5 blocks away)"
msgstr[0] "أقرب منطقة أحيائية تطابق @1 تقع عند الإحداثيات (@2، @3، @4) (على بُعد @5 كتلة)."
msgstr[1] "أقرب منطقة أحيائية تطابق @1 تقع عند الإحداثيات (@2، @3، @4) (على بُعد @5 كتلة)."
msgstr[2] "أقرب منطقة أحيائية تطابق @1 تقع عند الإحداثيات (@2، @3، @4) (على بُعد @5 كتلة)."
msgstr[3] "أقرب منطقة أحيائية تطابق @1 تقع عند الإحداثيات (@2، @3، @4) (على بُعد @5 كتل)."
msgstr[4] "أقرب منطقة أحيائية تطابق @1 تقع عند الإحداثيات (@2، @3، @4) (على بُعد @5 كتلة)."
msgstr[5] "أقرب منطقة أحيائية تطابق @1 تقع عند الإحداثيات (@2، @3، @4) (على بُعد @5 كتلة)."

#: mods/MAPGEN/mcl_biome_dispatch/init.lua:1152
msgid "No biome matching @1 exists near your position"
msgstr "لا توجد منطقة أحيائية تطابق @1 بالقرب من موقعك."

#: mods/MAPGEN/mcl_biome_dispatch/init.lua:1159
msgid ""
"/locate poi requires an identifier designating a valid point of interest.\n"
"These points of interest are available: "
msgstr "يتطلب الأمر `/locate poi` معرّفاً يشير إلى نقطة اهتمام صالحة.\nنقاط الاهتمام المتاحة هي: "

#: mods/MAPGEN/mcl_biome_dispatch/init.lua:1168
msgid "@1 does not identify a valid point of interest"
msgstr "@1 لا يعرّف نقطة اهتمام صالحة."

#: mods/MAPGEN/mcl_biome_dispatch/init.lua:1195
msgid "No point of interest named @1 exists near your position"
msgstr "لا توجد نقطة اهتمام باسم @1 بالقرب من موقعك."

