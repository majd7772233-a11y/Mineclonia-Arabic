msgid "Enable dust particles in the nether"
msgstr "تفعيل جسيمات الغبار في العالم السفلي"

msgid "Enable clouds"
msgstr "تفعيل السحب"

msgid "Gives ability to control weather"
msgstr "يمنح القدرة على التحكم في الطقس"

msgid "Changes the weather to the specified parameter."
msgstr "يغيّر الطقس إلى الحالة المحددة."

msgid "Error: No weather specified."
msgstr "خطأ: لم يتم تحديد حالة الطقس."

msgid "Error: Invalid parameters."
msgstr "خطأ: معاملات غير صالحة."

msgid "Error: Duration can't be less than 1 second."
msgstr "خطأ: لا يمكن أن تكون المدة أقل من ثانية واحدة."

msgid "Error: Invalid weather specified. Use “clear”, “rain”, or “thunder”."
msgstr "خطأ: حالة الطقس المحددة غير صالحة. استخدم “clear” أو “rain” أو “thunder”."

msgid "Toggles between clear weather and weather with downfall (randomly rain, thunderstorm or snow)"
msgstr "التبديل بين الطقس الصحو والطقس المصحوب بهطول (مطر أو عاصفة رعدية أو ثلج عشوائياً)."

