#: mods/ITEMS/mcl_flowers/init.lua:8
msgid ""
"This is a small flower. Small flowers are mainly used for dye production and "
"can also be potted."
msgstr "هذه زهرة صغيرة. تُستخدم الأزهار الصغيرة أساسًا في إنتاج الأصباغ، ويمكن أيضًا زراعتها في أصص."

#: mods/ITEMS/mcl_flowers/init.lua:9
msgid "It can only be placed on a block on which it would also survive."
msgstr "لا يمكن وضعها إلا على كتلة تستطيع البقاء والنمو عليها."

#: mods/ITEMS/mcl_flowers/init.lua:385
msgid "@1 (Top Part)"
msgstr "@1 (الجزء العلوي)"

