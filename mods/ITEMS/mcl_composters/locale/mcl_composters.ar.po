#: mods/ITEMS/mcl_composters/init.lua:12 mods/ITEMS/mcl_composters/init.lua:260
#: mods/ITEMS/mcl_composters/init.lua:312
msgid "Composter"
msgstr "حاوية التسميد"

#: mods/ITEMS/mcl_composters/init.lua:15
msgid "Composters can convert various organic items into bonemeal."
msgstr "تحوّل حاويات التسميد مختلف العناصر العضوية إلى مسحوق العظام."

#: mods/ITEMS/mcl_composters/init.lua:18
msgid ""
"Use organic items on the composter to fill it with layers of compost. Every "
"time an item is put in the composter, there is a chance that the composter "
"adds another layer of compost.  Some items have a bigger chance of adding an "
"extra layer than other items.  After filling up with 7 layers of compost, "
"the composter is full.  After a delay of approximately one second the "
"composter becomes ready and bone meal can be retrieved from it. Right-"
"clicking the composter takes out the bone meal empties the composter."
msgstr "استخدم العناصر العضوية على حاوية التسميد لملئها بطبقات من السماد. في كل مرة تضيف فيها عنصراً، هناك احتمال أن تكتسب الحاوية طبقة سماد إضافية. وتكون فرصة إضافة طبقة أكبر لبعض العناصر مقارنةً بغيرها. بعد امتلاء الحاوية بسبع طبقات من السماد، تصبح ممتلئة. وبعد تأخير يقارب ثانية واحدة، تصبح جاهزة، ويمكنك أخذ مسحوق العظام منها. انقر بزر الفأرة الأيمن على حاوية التسميد لأخذ مسحوق العظام وإفراغها."

#: mods/ITEMS/mcl_composters/init.lua:226
msgid "Converts organic items into bonemeal"
msgstr "تحوّل العناصر العضوية إلى مسحوق العظام"

#: mods/ITEMS/mcl_composters/init.lua:260
msgid "filled"
msgstr "ممتلئ"

#: mods/ITEMS/mcl_composters/init.lua:312
msgid "ready for harvest"
msgstr "جاهز للحصاد"
